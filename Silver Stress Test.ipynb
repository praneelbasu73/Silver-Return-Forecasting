    "## Stage 1: Prediction Target Definitions\n",
    "\n",
    "data['Silver_Return_1D'] = data['Silver'].pct_change()\n",
    "data['Silver_Return_1D']\n",
    "\n",
    "data['Silver_Return_5D_Forward'] = (\n",
    "    data['Silver'].shift(-5) / data['Silver'] - 1\n",
    ")\n",
    "\n",
    "data['Silver_Return_5D_Forward'] \n",
    "\n",
    "model_data = data.dropna(\n",
    "    subset=['Silver_Return_5D_Forward']\n",
    ").copy()\n",
    "\n",
    "model_data[\n",
    "    ['Date', 'Silver', 'Gold', 'GSR',\n",
    "     'Silver_Return_1D', 'Silver_Return_5D_Forward']\n",
    "].head(10)\n",
    "\n",
    "print(\n",
    "    model_data['Silver_Return_5D_Forward'].describe()\n",
    ")\n",
    "\n"
